# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — server-local secrets (Mongo creds, auth secrets). Never commit.
# .env / .env.production etc. are already tracked; only *local* files are ignored.
.env*.local
.env.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul
nul.bak

# claude temp directories
tmpclaude-*

# playwright mcp
.playwright-mcp/

# local dev server log
.dev-server.log
